# 1. Supabase Public Client Credentials (Exposed to browser)
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# 2. Supabase Server-Only Secret (STRICTLY SERVER-SIDE - NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# 3. Cryptographic Session Secret (Min 32 characters HMAC-SHA256 key)
SESSION_SECRET=<random-32-character-secret-key>

# 4. Super-Admin Permanent Provisioning
ADMIN_EMAIL=techno3deepak@gmail.com
ADMIN_USERNAME=Deepak@8960@techno
ADMIN_PASSWORD_HASH=<generated-pbkdf2-hash-via-scripts-provision-admin>
ADMIN_PASSWORD_SALT=<generated-pbkdf2-salt-via-scripts-provision-admin>

# 5. Production Host URL
NEXT_PUBLIC_SITE_URL=https://<your-vercel-domain>.vercel.app
