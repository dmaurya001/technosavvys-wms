# ==============================================================================
# TECHNOSAVVYS WORKSHOP MANAGEMENT SYSTEM - HOSTINGER PRODUCTION TEMPLATE
# ==============================================================================

# 1. Hostinger MySQL Database Configuration (Primary for Hostinger)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=u123456789_technosavvys
MYSQL_USER=u123456789_admin
MYSQL_PASSWORD=<your-hostinger-mysql-password>

# 2. Cryptographic Secrets (Min 32 random chars each; must be unique)
SESSION_SECRET=<random-32-character-session-secret>
STUDENT_SESSION_SECRET=<random-32-character-student-secret>
QR_TOKEN_SECRET=<random-32-character-qr-secret>

# 3. Super-Admin Provisioning (Generate hash/salt via scripts/provision-admin.mjs)
ADMIN_EMAIL=<admin-email>
ADMIN_USERNAME=<admin-username>
ADMIN_NAME=<admin-display-name>
ADMIN_PASSWORD_HASH=<generated-pbkdf2-hash>
ADMIN_PASSWORD_SALT=<generated-pbkdf2-salt>

# 4. Production Host & HTTPS Cookie Security
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
COOKIE_SECURE=true

# 5. Optional SMTP (For Student Portal Email OTP)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=<noreply@yourdomain.com>
SMTP_PASS=<smtp-password>
SMTP_FROM="Technosavvys WMS <noreply@yourdomain.com>"

# 6. Optional Supabase (Leave empty if using Hostinger MySQL)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
